{
  "mcpServers": {
    "midscene-web-bridge": {
      "command": "npx",
      "args": ["-y", "@midscene/web-bridge-mcp@1.9.6"],
      "env": {
        "MIDSCENE_MODEL_NAME": "claude-sonnet-5",
        "MIDSCENE_API_KEY": "${MIDSCENE_API_KEY}"
      }
    },
    "mongodb": {
      "command": "npx",
      "args": ["-y", "mongodb-mcp-server@1.0.1"],
      "env": {
        "MDB_MCP_CONNECTION_STRING": "${MDB_MCP_CONNECTION_STRING}"
      }
    },
    "socraticode": {
      "command": "npx",
      "args": ["-y", "socraticode@1.9.0"]
    },
    "slack": {
      "command": "npx",
      "args": ["-y", "slack-mcp-server@1.3.0"],
      "env": {
        "SLACK_MCP_XOXP_TOKEN": "${SLACK_MCP_XOXP_TOKEN}"
      }
    },
    "browsermcp": {
      "command": "npx",
      "args": ["-y", "@browsermcp/mcp@0.1.3"]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@1.6.0"]
    }
  }
}
